{
  "schema_version": 1,
  "project_root": "..",
  "data_dir": "code/NeuralODE/data/750sample/batch_v10/data",
  "runs_dir": "runs",
  "threads": 2,
  "entrypoints": [
    "code/DATASET/total_generator_normalize_v10.py",
