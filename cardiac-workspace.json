        "--history-steps",
        "4",
        "--width",
        "8",
        "--graph-layers",
        "1",
        "--loss-nodes",
        "128",
        "--val-cases",
        "0",
        "--save-every",
        "1"
      ],
      "dependencies": [
        "torch",
        "numpy",
        "scipy"
