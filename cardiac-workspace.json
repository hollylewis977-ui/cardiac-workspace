  "tasks": {
    "server-tests": {
      "description": "TC_GCN_server 的 AR/PCA、协议和结果处理回归测试",
      "cwd": "code/TC_GCN_server",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        ".",
        "-p",
        "test_*.py",
        "-v"
      ],
      "dependencies": [
        "torch",
        "numpy",
        "scipy",
        "matplotlib"
      ],
      "requires_data": false,
      "timeout_seconds": 300
    },
    "direct-tests": {
      "description": "FBNO_time_forecast 直接时间查询、未来标签隔离与预测回归测试",
      "cwd": "code/FBNO_time_forecast",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        ".",
        "-p",
        "test_*.py",
