{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "round_id": {
      "type": "string"
    },
    "packet_sha256": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "continue",
        "waiting",
        "blocked",
        "completed"
      ]
    },
    "next_phase": {
      "type": "string",
      "enum": [
        "analyze",
        "implement",
        "experiment",
        "assess"
      ]
    },
    "progress_made": {
      "type": "boolean"
    },
    "summary": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "blocker": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "log": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code",
          "log"
        ],
        "additionalProperties": false
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "outcome",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "progress": {
      "type": "object",
      "properties": {
        "claimed_kind": {
          "type": "string",
          "enum": [
            "frontier-advance",
            "route-elimination",
            "enabling-result",
            "experimental-signal",
            "reformulation",
            "repeat",
            "inconclusive",
            "regression",
            "candidate-solution"
          ]
        },
        "main_problem_effect": {
          "type": "string"
        },
        "scope_limitations": {
          "type": "string"
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "conjecture",
            "experimental",
            "partial-result",
            "proof-draft"
          ]
        }
      },
      "required": [
        "claimed_kind",
        "main_problem_effect",
        "scope_limitations",
        "evidence_level"
      ],
      "additionalProperties": false
    },
    "new_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "conjecture",
              "experimental",
              "partial-result",
              "proof-draft"
            ]
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "code",
                "numerics",
                "data",
                "prediction",
                "personalization",
                "uncertainty"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "statement",
          "level",
          "dimensions",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "round_id",
    "packet_sha256",
    "status",
    "next_phase",
    "progress_made",
    "summary",
    "next_action",
    "current_state",
    "blocker",
    "evidence",
    "checks",
    "acceptance"
  ],
  "additionalProperties": false
}
